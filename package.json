{
  "name": "zyvor-argus",
  "version": "0.9.2",
  "private": true,
  "description": "Playwright test execution layer for Zyvor Argus",
  "workspaces": [
    "desktop"
  ],
  "scripts": {
    "desktop": "zyvor-argus-desktop dev",
    "desktop:dev": "zyvor-argus-desktop dev",
    "desktop:build": "zyvor-argus-desktop build",
    "desktop:run": "zyvor-argus-desktop run",
    "test": "playwright test --config=playwright/playwright.config.ts",
    "test:manual": "playwright test --config=playwright/playwright.config.ts tests/manual",
    "test:generated": "playwright test --config=playwright/playwright.config.ts tests/generated",
    "test:snapshots": "playwright test --config=playwright/playwright.config.ts --grep @visual",
    "test:snapshots:update": "playwright test --config=playwright/playwright.config.ts --grep @visual --update-snapshots",
    "record-flow": "node playwright/scripts/record-flow.mjs",
    "crawl": "node playwright/scripts/crawl-site.mjs",
    "report": "playwright show-report reports",
    "report:pdf": "node playwright/scripts/html-to-pdf.mjs reports/qa-summary.html reports/qa-summary.pdf",
    "docs:guides": "node scripts/customer-docs/generate-guides.mjs && node scripts/customer-docs/generate-guide-index.mjs && node scripts/customer-docs/generate-page-index.mjs",
    "docs:links": "node scripts/customer-docs/check-links.mjs",
    "docs:pdf": "node scripts/customer-docs/build-customer-pdfs.mjs",
    "docs:sync": "node scripts/customer-docs/sync-to-website.mjs"
  },
  "dependencies": {
    "axe-core": "^4.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
