APP_NAME=Zyvor Technical QA Agent
APP_ENV=development
LOG_LEVEL=INFO
APP_API_KEY=change-me
# Production alternative: JSON map of token -> tenant/access claims.
# AUTH_TOKENS_JSON={"token-acme":{"tenant_id":"acme","access_levels":["public","customer"]}}
AUTH_TOKENS_JSON=

# OpenAI or any OpenAI-compatible endpoint, including vLLM.
LLM_MODEL=gpt-5.5
LLM_API_KEY=replace-me
LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=90
# Optional fallback model if the primary fails
# LLM_FALLBACK_MODEL=gpt-4o-mini
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_BASE_URL=

# May use a separate OpenAI-compatible embedding endpoint — or local FastEmbed:
# EMBEDDING_BACKEND=fastembed
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=zyvor_knowledge
QDRANT_TIMEOUT_SECONDS=30

RETRIEVAL_K=8
RETRIEVAL_FETCH_K=16
MAX_TOOL_CALLS=8
MAX_QUERY_LENGTH=4000
ENABLE_PUBLIC_DOCUMENTS=true
DEFAULT_ACCESS_LEVELS=public,customer
KNOWLEDGE_TENANT_ID=public
KNOWLEDGE_ACCESS_LEVELS=public,customer
# SQLite conversation checkpoints (use :memory: for ephemeral)
KNOWLEDGE_CHECKPOINT_PATH=reports/knowledge-checkpoints.sqlite
# Opt-in read-only live cluster diagnostics (never mutates)
ENABLE_LIVE_CLUSTER_TOOLS=false
# Separate HITL remediation planner (not the primary QA agent)
ENABLE_REMEDIATION_AGENT=false
# After HITL approve, optionally execute allowlisted pod restarts
ENABLE_REMEDIATION_EXECUTOR=false
# REMEDIATION_RESTART_NAMESPACES=demo,kube-system
# REMEDIATION_RESTART_NAME_PREFIXES=hubble-,cilium-
ENABLE_QUERY_UNDERSTANDING=true
ENABLE_ASK_STREAMING=true
# Comma allowlist; empty = Mission Control DASHBOARD_NAMESPACE only. Use * to allow any valid name.
# KNOWLEDGE_LIVE_NAMESPACES=default,kube-system,rook-ceph
# Optional LangSmith tracing for knowledge-evaluate --langsmith
# LANGSMITH_API_KEY=
# LANGCHAIN_PROJECT=zyvor-knowledge-eval
